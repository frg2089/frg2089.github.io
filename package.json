{
  "name": "shimakaze-blog",
  "version": "2.0.0",
  "type": "module",
  "description": "岛风的博客",
  "license": "MIT",
  "packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a",
  "scripts": {
    "build": "vitepress build",
    "dev": "vitepress dev",
    "format": "prettier --write .",
    "prepare": "husky",
    "preview": "vitepress preview"
  },
  "devDependencies": {
    "@giscus/vue": "^3.1.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "latest",
    "algoliasearch": "^5.52.1",
    "commander": "^14.0.3",
    "gray-matter": "^4.0.3",
    "holiday-calendar": "latest",
    "htmlparser2": "^12.0.0",
    "husky": "^9.1.7",
    "iso-3166-1": "^2.1.1",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-pkg": "^0.22.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitepress": "1.6.4",
    "vitepress-plugin-legend": "^2.0.0",
    "vitepress-plugin-rss": "^0.4.4",
    "vitepress-theme-teek": "^1.5.7",
    "vue": "^3.5.34",
    "vue-tsc": "^3.2.8"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false,
    "semi": false,
    "singleQuote": true,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": true,
    "arrowParens": "avoid",
    "endOfLine": "auto",
    "plugins": [
      "prettier-plugin-organize-imports",
      "prettier-plugin-pkg"
    ]
  }
}
